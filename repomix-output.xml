    () => `This is fine. Everything about getting from A to B is fine.`,
  ],
  entertainment: [
    (t) => `${t.merchant}. An investment in feeling something for two hours.`,
    (t) => `Fun has a price tag now, apparently ₹${t.amount} of one.`,
