.empty-transactions p, .transaction-empty p, .analytics-empty p { color: var(--muted); margin-bottom: 18px; }

.analytics-filter {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4px;
  padding: 4px;
  border: 1px solid var(--border);
  border-radius: 999px;
}
.analytics-filter svg { color: var(--dim); margin: 0 8px; }
.analytics-filter button {
  padding: 8px 12px;
  color: var(--dim);
  border-radius: 999px;
  font-size: 12px;
  font-weight: 600;
}
.analytics-filter button.active, .analytics-filter button:hover {
  color: #07110c;
  background: var(--lime);
}
.analytics-stat svg { color: var(--lime); margin-bottom: 6px; }
.recharts-wrap { height: 285px; margin-top: 16px; }
.category-chart-body { display: flex; align-items: center; gap: 8px; margin-top: 18px; }
.category-legend { flex: 1; display: grid; gap: 10px; }
.category-legend div { display: grid; grid-template-columns: 9px 1fr auto; align-items: center; gap: 8px; color: var(--muted); font-size: 13px; }
.category-legend i { width: 8px; height: 8px; border-radius: 50%; }
.category-legend b { color: var(--text); font-family: var(--mono); font-size: 12px; }
.chart-empty { height: 240px; display: grid; place-items: center; color: var(--dim); font-size: 13px; }
.insight-list { margin-top: 12px; }
.report-insight {
  display: grid;
  grid-template-columns: 36px 1fr 20px;
  align-items: center;
  gap: 12px;
  min-height: 58px;
  border-top: 1px solid var(--border-subtle);
}
.report-insight span { color: var(--lime); font-family: var(--mono); font-size: 12px; }
.report-insight p { color: var(--muted); }

.transaction-tools {
  display: grid;
  grid-template-columns: minmax(220px, 1fr) repeat(4, auto);
  gap: 10px;
  margin-bottom: 14px;
}
.transaction-list-head, .advanced-row {
  display: grid;
  grid-template-columns: 1.6fr 1.3fr 0.85fr 0.9fr 86px;
  align-items: center;
  gap: 12px;
}
.transaction-list-head {
  padding: 10px 16px;
  color: var(--dim);
  font-size: 12px;
}
.advanced-row {
  min-height: 74px;
  padding: 12px 16px;
  border-top: 1px solid var(--border-subtle);
}
.merchant-cell { display: flex; align-items: center; gap: 12px; min-width: 0; }
.merchant-cell strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.category-cell span, .category-cell small { display: block; }
.category-cell span { color: var(--muted); font-size: 13px; }
.category-cell small { color: var(--dim); margin-top: 4px; font-size: 12px; }
.type-pill {
  justify-self: start;
  padding: 5px 8px;
  font-size: 11px;
  font-weight: 600;
  border-radius: 999px;
}
.type-pill.income { color: var(--lime); background: var(--primary-soft); }
.type-pill.expense { color: var(--health-warn); background: color-mix(in srgb, var(--health-warn) 14%, transparent); }
.row-actions { display: flex; justify-content: flex-end; }
.success-notice {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 12px;
  padding: 10px 13px;
  color: var(--accent-dark);
  background: var(--primary-soft);
  border: 1px solid color-mix(in srgb, var(--lime) 28%, var(--border));
  border-radius: 14px;
  font-size: 13px;
}
.delete-button { color: #fff; background: var(--red); }
.confirm-icon {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  margin-bottom: 18px;
  color: var(--red);
  background: color-mix(in srgb, var(--red) 12%, transparent);
  border-radius: 12px;
}
.modal-copy { color: var(--muted); margin: 10px 0 22px; line-height: 1.6; }

.financial-health {
  min-width: 270px;
  padding: 18px 20px;
  border: 1px solid var(--border);
  border-left: 4px solid var(--health-ok);
  background: var(--surface-card);
  box-shadow: var(--shadow-sm);
  position: relative;
  overflow: hidden;
}
.financial-health.orange { border-left-color: var(--health-warn); }
.financial-health.red { border-left-color: var(--health-critical); }
.health-top { display: flex; justify-content: space-between; gap: 16px; align-items: flex-start; }
.health-top h2 { margin: 8px 0 0; font-size: 18px; }
.health-top h2 i { display: inline-block; width: 8px; height: 8px; margin-right: 8px; border-radius: 50%; background: var(--health-ok); }
.financial-health.orange .health-top h2 i { background: var(--health-warn); }
.financial-health.red .health-top h2 i { background: var(--health-critical); }
.financial-health > svg { color: var(--health-ok); }
.financial-health.orange > svg { color: var(--health-warn); }
.financial-health.red > svg { color: var(--health-critical); }
.financial-health p { max-width: 300px; margin: 12px 0; color: var(--muted); font-size: 14px; line-height: 1.5; }

.quick-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 16px 18px;
  margin-bottom: 14px;
}
.quick-action-buttons { display: flex; flex-wrap: wrap; gap: 8px; }
.text-button { color: var(--text); text-decoration: none; background: var(--surface); border: 1px solid var(--border); }

.toast {
  position: fixed;
  right: 24px;
  bottom: 24px;
  z-index: var(--z-toast);
  padding: 12px 16px;
  color: #07110c;
  background: var(--lime);
  border-radius: 999px;
  font-size: 13px;
  font-weight: 600;
  box-shadow: var(--shadow-md);
}

.mobile-bottom-nav { display: none; }
.sidebar-backdrop { display: none; }

@media (max-width: 1024px) {
  .page { padding: 28px 22px 72px; }
  .topbar { padding-inline: 22px; }
  .dashboard-grid, .analytics-panels, .analytics-grid { grid-template-columns: 1fr; }
  .metrics, .financial-summary, .analytics-statistics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .transaction-tools { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .transaction-tools .search { grid-column: 1 / -1; }
}

@media (max-width: 800px) {
  .auth { grid-template-columns: 1fr; }
  .auth-brand {
    min-height: 0;
    padding: calc(24px + env(safe-area-inset-top)) 20px 20px;
    border-right: 0;
    border-bottom: 1px solid var(--border);
  }
  .auth-brand h1 { font-size: clamp(42px, 12vw, 58px); }
  .auth-form { padding: 24px 20px calc(28px + env(safe-area-inset-bottom)); }
  .sidebar-backdrop {
    display: block;
    position: fixed;
    inset: 0;
    background: rgba(7, 9, 13, 0.55);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.28s ease;
    z-index: var(--z-drawer-backdrop);
  }
  .sidebar-backdrop.open { opacity: 1; pointer-events: auto; }
  .sidebar {
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    width: min(82vw, 300px);
    transform: translateX(-105%);
    transition: transform 0.32s cubic-bezier(.22, 1, .36, 1);
    z-index: var(--z-drawer);
    overflow-y: auto;
  }
  .sidebar.open { transform: translateX(0); }
  .close-drawer, .menu-button { display: grid; }
  .topbar-brand { display: inline-flex; flex: none; }
  .topbar-brand .brand-logo-wordmark { display: none; }
  .topbar { min-height: 64px; padding: 0 12px; }
  .topbar-title h3 { font-size: 17px; }
  .date { display: none; }
  .modal-backdrop { place-items: end center; }
  .mobile-bottom-nav {
    display: grid;
    grid-template-columns: 1fr 1fr 72px 1fr 1fr;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: var(--z-nav);
    background: var(--glass-strong);
    border-top: 1px solid var(--glass-border);
    backdrop-filter: blur(18px);
    padding: 8px 10px calc(8px + env(safe-area-inset-bottom));
    align-items: end;
  }
  @media (max-width: 800px) {
  .mobile-bottom-nav {
    padding: 6px 12px calc(6px + env(safe-area-inset-bottom));
    background: color-mix(in srgb, var(--background) 92%, transparent);
    backdrop-filter: blur(24px) saturate(140%);
    border-top: 1px solid var(--border-subtle);
  }
  .bottom-nav-link {
    min-height: 44px;
    font-size: 10px;
    gap: 2px;
  }
  .bottom-nav-link svg { width: 20px; height: 20px; }
  .add-nav-action {
    width: 52px;
    height: 52px;
    margin: -18px auto 0;
    box-shadow: 0 10px 24px color-mix(in srgb, var(--lime) 42%, transparent);
  }
}
  .bottom-nav-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    min-height: 48px;
    color: var(--dim);
    font-size: 11px;
    font-weight: 600;
    border-radius: 14px;
  }
  .bottom-nav-link.active, .bottom-nav-link:hover { color: var(--text); background: var(--primary-soft); }
  .add-nav-action {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    margin: -22px auto 4px;
    color: #07110c;
    background: var(--lime);
    border-radius: 50%;
    box-shadow: 0 12px 28px color-mix(in srgb, var(--lime) 38%, transparent);
  }
  .add-nav-action svg { width: 22px; height: 22px; }
  .add-nav-hint {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 10px);
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    color: var(--text);
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 12px;
    white-space: nowrap;
    pointer-events: none;
  }
  .add-welcome {
    position: fixed;
    left: 50%;
    bottom: calc(86px + env(safe-area-inset-bottom));
    z-index: var(--z-toast);
    transform: translateX(-50%);
    padding: 10px 14px;
    color: #07110c;
    background: var(--lime);
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    pointer-events: none;
  }
  .quick-actions { flex-direction: column; align-items: flex-start; }
  .page-intro .financial-health { width: 100%; }
  .insights, .scores, .monthly-items { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 520px) {
  .page-intro { flex-direction: column; align-items: flex-start; }
  .page-intro h1 { font-size: clamp(28px, 8vw, 36px); }
  .metrics, .financial-summary, .analytics-statistics, .insights, .scores, .achievement-grid, .monthly-items { grid-template-columns: 1fr; }
  .section-head { flex-direction: column; }
  .form-row, .transaction-tools { grid-template-columns: 1fr; }
  .transaction-list-head { display: none; }
  .advanced-row { grid-template-columns: 1fr auto auto; gap: 8px; padding: 14px 10px; }
  .category-cell { grid-column: 1; margin-left: 50px; }
  .type-pill { grid-column: 2; grid-row: 1; }
  .advanced-amount { grid-column: 3; grid-row: 1; }
  .row-actions { grid-column: 2 / 4; grid-row: 2; }
  .personality-hero { flex-direction: column; align-items: flex-start; padding: 22px; }
  .modal-actions { flex-direction: column-reverse; }
  .modal-actions .button, .compact-intro > .button, .auth-form .button { width: 100%; }
  .quick-action-buttons { width: 100%; display: grid; }
  .quick-action-buttons .button { width: 100%; }
  .toast { left: 14px; right: 14px; bottom: calc(92px + env(safe-area-inset-bottom)); text-align: center; }
  .tx-time { display: none; }
}

@keyframes auth-pulse { 0%, 100% { opacity: 0.45; transform: scaleY(0.7); } 50% { opacity: 1; transform: scaleY(1); } }
@keyframes page-enter { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

.page > *:not(.dashboard-ambient) { position: relative; z-index: 1; animation: page-enter 420ms ease both; }
.dashboard-ambient { position: absolute; inset: -8vh -6vw; overflow: hidden; pointer-events: none; z-index: 0; }
.ambient-orb { position: absolute; display: block; border-radius: 50%; filter: blur(72px); opacity: 0.16; }
.orb-one { width: 360px; height: 360px; top: 4%; left: 8%; background: var(--lime); }
.orb-two { width: 260px; height: 260px; top: 42%; right: 4%; background: var(--accent-soft); opacity: 0.1; }
.orb-three { width: 220px; height: 220px; bottom: 8%; left: 40%; background: var(--text-secondary); opacity: 0.06; }

.roastscan {
  display: grid;
  gap: 14px;
  padding-bottom: calc(28px + env(safe-area-inset-bottom));
}
.roastscan-layout {
  display: grid;
  gap: 14px;
  padding-bottom: calc(168px + env(safe-area-inset-bottom));
}
.roastscan-hero { padding: 18px 16px 16px; }
.roastscan-hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
}
.roastscan-hero-top .eyebrow { margin: 0; color: var(--lime); letter-spacing: 0.12em; text-transform: uppercase; }
.roastscan-hero-main {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 72px;
  gap: 16px;
  align-items: end;
}
.roastscan-hero-copy { min-width: 0; }
.roastscan-hero-copy small { color: var(--dim); }
.roastscan-thumb {
  width: 72px;
  height: 96px;
  margin: 0;
  padding: 0;
  overflow: hidden;
  border-radius: 16px;
  border: 1px solid color-mix(in srgb, var(--lime) 28%, var(--border));
  background: var(--surface);
  box-shadow: 0 10px 24px color-mix(in srgb, var(--lime) 12%, transparent);
}
.roastscan-thumb img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.roastscan-amount {
  display: block;
  margin: 0 0 8px;
  font-family: var(--mono);
  font-size: clamp(36px, 10vw, 52px);
  letter-spacing: -2px;
  line-height: 0.95;
  overflow-wrap: anywhere;
  color: var(--text);
}
.roastscan-merchant {
  color: var(--text);
  margin: 0 0 4px;
  font-size: 17px;
  font-weight: 600;
}
.roastscan-confidence {
  display: inline-flex;
  padding: 6px 10px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.02em;
  border: 1px solid var(--border);
}
.roastscan-confidence.high { color: #07110c; background: var(--lime); border-color: transparent; }
.roastscan-confidence.review { color: var(--health-warn); background: color-mix(in srgb, var(--health-warn) 12%, transparent); }
.roastscan-confidence.low { color: var(--health-critical); background: color-mix(in srgb, var(--health-critical) 12%, transparent); }
.roastscan-summary ul {
  display: grid;
  gap: 0;
  margin: 0;
  padding: 0;
  list-style: none;
}
.roastscan-summary li {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  padding: 14px 0;
  border-bottom: 1px solid var(--border-subtle);
}
.roastscan-summary li:last-child { border-bottom: 0; padding-bottom: 0; }
.roastscan-summary li:first-child { padding-top: 0; }
.roastscan-summary span { color: var(--dim); font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase; }
.roastscan-summary strong { font-size: 14px; text-align: right; overflow-wrap: anywhere; }
.roastscan-hint, .roastscan-status-card p { color: var(--muted); margin: 12px 0 0; }
.roastscan-edit { display: grid; gap: 14px; padding: 16px; }
.roastscan-edit label {
  display: grid;
  gap: 7px;
  color: var(--dim);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.roastscan-edit input,
.roastscan-edit select {
  width: 100%;
  min-height: 48px;
  padding: 12px 14px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: var(--surface-elevated);
  color: var(--text);
  font: inherit;
  font-size: 16px;
  letter-spacing: 0;
  text-transform: none;
  appearance: none;
}
.roastscan-edit input:focus,
.roastscan-edit select:focus {
  outline: none;
  border-color: color-mix(in srgb, var(--lime) 55%, var(--border));
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--lime) 18%, transparent);
}
.roastscan-edit-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.roastscan-type-toggle {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
  padding: 4px;
  border-radius: 16px;
  background: var(--surface-elevated);
  border: 1px solid var(--border);
}
.roastscan-type-toggle button {
  min-height: 42px;
  border: 0;
  border-radius: 12px;
  background: transparent;
  color: var(--muted);
  font-weight: 600;
}
.roastscan-type-toggle button.active {
  color: #07110c;
  background: var(--lime);
}
.roastscan-empty {
  display: grid;
  gap: 10px;
  justify-items: start;
  padding: 24px 18px;
}
.roastscan-banner, .roastscan-duplicate, .roastscan-saved {
  padding: 12px 14px;
  border-radius: 14px;
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--muted);
  font-size: 14px;
  line-height: 1.45;
}
.roastscan-duplicate { border-color: color-mix(in srgb, var(--health-warn) 45%, var(--border)); }
.roastscan-saved {
  display: grid;
  gap: 10px;
  border-color: color-mix(in srgb, var(--lime) 40%, var(--border));
}
.roastscan-saved .roast-quote { margin: 6px 0 0; }
.roastscan-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(72px + env(safe-area-inset-bottom));
  z-index: 20;
  display: grid;
  gap: 8px;
  padding: 12px 16px 10px;
  background: color-mix(in srgb, var(--background) 88%, transparent);
  backdrop-filter: blur(18px);
  border-top: 1px solid var(--border-subtle);
}
.roastscan-actions .button.lime { width: 100%; justify-content: center; }
.roastscan-secondary { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.roastscan-secondary .button { width: 100%; justify-content: center; }

@media (min-width: 801px) {
  .roastscan-layout { padding-bottom: 132px; }
  .roastscan-actions {
    left: auto;
    right: auto;
    width: min(720px, calc(100% - 56px));
    margin: 0 auto;
    bottom: 16px;
    border: 1px solid var(--border-subtle);
    border-radius: 22px;
  }
}

@media (max-width: 800px) {
  .roastscan-hero { grid-template-columns: none; padding: 16px 14px; }
  .roastscan-edit-row { grid-template-columns: 1fr; }
}

@media (prefers-reduced-motion: reduce) {
  .page > * { animation: none; }
  .auth-pulse i { animation: none; }
}
/* ─── Budgets ─────────────────────────────────────────────────────── */

.budget-month-nav {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 4px;
  border: 1px solid var(--border);
  border-radius: 999px;
}
.budget-month-label {
  min-width: 140px;
  text-align: center;
  font-size: 13px;
  font-weight: 600;
}

.budget-summary { padding: 20px 24px; margin-bottom: 14px; }
.budget-summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
}
.budget-summary-grid small {
  display: block;
  margin-bottom: 4px;
  color: var(--dim);
  font-size: 12px;
}
.budget-summary-grid strong {
  font-family: var(--mono);
  font-size: 22px;
  letter-spacing: -0.6px;
}

.budget-list { display: grid; gap: 12px; }
.budget-row {
  padding: 18px 20px;
  border-left: 3px solid var(--health-ok);
}
.budget-row.budget-warn { border-left-color: var(--health-warn); }
.budget-row.budget-critical { border-left-color: var(--health-warn); }
.budget-row.budget-over { border-left-color: var(--health-critical); }

.budget-row-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16px;
  margin-bottom: 12px;
}
.budget-amount {
  display: block;
  margin-top: 6px;
  font-family: var(--mono);
  font-size: 20px;
  letter-spacing: -0.6px;
}
.budget-amount-of { color: var(--dim); font-size: 14px; font-weight: 400; }
.budget-row-actions { display: flex; gap: 4px; }

.budget-bar {
  height: 6px;
  background: var(--border);
  border-radius: 999px;
  overflow: hidden;
}
.budget-bar i {
  display: block;
  height: 100%;
  background: var(--health-ok);
  border-radius: inherit;
  transition: width 320ms ease;
}
.budget-warn .budget-bar i,
.budget-critical .budget-bar i { background: var(--health-warn); }
.budget-over .budget-bar i { background: var(--health-critical); }

.budget-row-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 8px;
  color: var(--dim);
  font-size: 12px;
}

.budget-empty-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  justify-content: center;
}
.budget-add-more { justify-self: start; }

.budget-card { padding: 22px 24px; margin-bottom: 14px; }
.budget-card-list { display: grid; gap: 14px; margin-top: 16px; }
.budget-mini-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 12px;
  margin-bottom: 8px;
  font-size: 13px;
}
.budget-mini-top b {
  font-family: var(--mono);
  font-size: 12px;
