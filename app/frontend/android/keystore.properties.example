# Copy to keystore.properties (gitignored) and fill in your local values.
# Never commit keystore.properties, passwords, or the .jks file.
#
# Create an upload keystore once:
# keytool -genkeypair -v -keystore upload-keystore.jks -alias upload -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is relative to the android/ directory.

storeFile=upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
